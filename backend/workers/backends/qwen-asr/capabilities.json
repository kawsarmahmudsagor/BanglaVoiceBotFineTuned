{
  "name": "qwen-asr",
  "label": "Qwen3-ASR (transformers)",
  "tasks": {
    "asr": {
      "methods": [
        "full"
      ],
      "export_formats": [
        "safetensors"
      ],
      "serve_formats": [],
      "schema": {
        "type": "object",
        "properties": {
          "base_model": {
            "type": "string",
            "enum": [
              "SayedShaun/Qwen3-ASR-0.6B-Bengali",
              "Qwen/Qwen3-ASR-0.6B-hf"
            ]
          },
          "method": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "full"
                ]
              }
            }
          },
          "hparams": {
            "type": "object",
            "properties": {
              "learning_rate": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 0.001,
                "default": 2e-05
              },
              "epochs": {
                "type": "number",
                "minimum": 1,
                "maximum": 50,
                "default": 3
              },
              "max_steps": {
                "type": "integer",
                "minimum": 1
              },
              "batch_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16,
                "default": 8,
                "description": "per-device batch; logits over the 151,936-token vocabulary dominate memory, so use grad_accum for larger effective batches"
              },
              "grad_accum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "default": 1
              },
              "warmup_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5,
                "default": 0.02
              },
              "save_steps": {
                "type": "integer",
                "minimum": 1
              },
              "max_label_tokens": {
                "type": "integer",
                "minimum": 16,
                "maximum": 916,
                "default": 448,
                "description": "transcript tokens + EOS; at most eval's max_new_tokens for a 30 s clip (30/s + 16 = 916)"
              },
              "gradient_checkpointing": {
                "type": "boolean",
                "default": true
              },
              "freeze_audio_encoder": {
                "type": "boolean",
                "default": false,
                "description": "train only the LLM decoder and the audio projector"
              },
              "keep_checkpoints": {
                "type": "integer",
                "minimum": 1,
                "default": 2
              },
              "seed": {
                "type": "integer"
              },
              "eval": {
                "type": "object",
                "properties": {
                  "baseline": {
                    "type": "boolean",
                    "default": true
                  },
                  "max_samples": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 2000,
                    "description": "eval-phase samples (transcribed)"
                  },
                  "max_val_samples": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 2000,
                    "description": "validation rows used during training (seeded subset)"
                  }
                }
              },
              "prepare": {
                "type": "object"
              }
            }
          },
          "export": {
            "type": "array",
            "items": {
              "enum": [
                "safetensors"
              ]
            }
          }
        }
      }
    }
  }
}
