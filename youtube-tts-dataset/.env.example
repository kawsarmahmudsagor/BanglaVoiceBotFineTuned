# Copy to .env (never commit .env). Lookup order: process env > this folder's .env > repo-root .env.

# Local Ollama daemon. When signed in (`ollama signin`), it routes *-cloud models to Ollama cloud.
OLLAMA_HOST=http://localhost:11434
# Only needed when OLLAMA_HOST=https://ollama.com (direct cloud API, bearer auth).
OLLAMA_API_KEY=
LLM_MODEL=gemma4:31b-cloud
# Work data directory.
YTDS_DATA_DIR=youtube-tts-dataset/var
# Default export root.
YTDS_EXPORT_DIR=var/import
# Backend port.
YTDS_PORT=8765
# Only if a model download needs it.
HF_TOKEN=
# Transcription models: local folder or HF repo id.
MODEL_A_PATH=C:\Users\BS23-DESKTOP-00038\Downloads\qwen-3-asr-finetune-1\safetensors
MODEL_B_PATH=C:\Users\BS23-DESKTOP-00038\Downloads\whisper-finetune-1\modelswhisper-v3-bn-version1
