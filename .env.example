# Copy to .env and edit. Never commit .env.
# Format: KEY=value, no quotes, no spaces around "=", values must not contain $ or #.

# Absolute paths on the VM. DATA_ROOT holds datasets, runs, checkpoints and MLflow artifacts.
DATA_ROOT=/srv/mlops
REPO_ROOT=/home/ubuntu/BanglaVoiceBotFineTuned

# The password is embedded in database URLs: use letters and digits only (or URL-encode special characters).
# Postgres (compose creates the mlops and mlflow databases on first start).
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

# Used by the native worker and uv commands on the VM. The compose api service uses postgres:5432 instead.
# Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://mlops:change-me@localhost:5432/mlops
MLFLOW_TRACKING_URI=http://localhost:5000

# Browser origin allowed by CORS (the tunnelled web UI).
WEB_ORIGIN=http://localhost:3000

DISK_WARN_GB=20
DISK_MIN_GB=10
CANCEL_GRACE_S=60

# Model catalog YAML files. Defaults to <repo>/catalog; compose sets it to ${REPO_ROOT}/catalog.
# CATALOG_DIR=

# Hugging Face token
# needed for gated weights: IndicF5, Gemma 3, IndicConformer
HF_TOKEN=
